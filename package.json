{
	"name": "yomi",
	"version": "0.2.3",
	"private": true,
	"description": "ChatGPT サブスクリプションで Web ページ全体や選択テキストを翻訳する Chrome 拡張",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"build": "wxt build",
		"dev": "wxt",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"hero": "node scripts/hero.ts",
		"icons": "node scripts/icons.ts",
		"knip": "knip",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"postinstall": "wxt prepare",
		"test": "vitest run --project unit",
		"test:e2e": "vitest run --project e2e",
		"typecheck": "tsc --noEmit",
		"zip": "wxt zip"
	},
	"dependencies": {
		"entities": "8.1.0",
		"idb": "8.0.4",
		"openai": "7.32.0",
		"solid-js": "1.9.17",
		"valibot": "1.5.0"
	},
	"devDependencies": {
		"@shun-shobon/oxfmt-config": "7.1.0",
		"@shun-shobon/oxlint-config": "7.1.0",
		"@tsconfig/strictest": "2.0.8",
		"happy-dom": "20.14.6",
		"knip": "6.41.0",
		"oxfmt": "0.72.0",
		"oxlint": "1.87.0",
		"oxlint-tsgolint": "7.0.2004",
		"playwright-core": "1.64.0",
		"typescript": "7.0.2",
		"vite-plugin-solid": "2.11.14",
		"vitest": "5.0.4",
		"wxt": "0.21.4"
	},
	"packageManager": "pnpm@12.13.0"
}
