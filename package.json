{
  "name": "yomi",
  "version": "0.1.0",
  "private": true,
  "description": "ChatGPT plan powered page & selection translator",
  "type": "module",
  "scripts": {
    "build": "wxt build",
    "dev": "wxt",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "postinstall": "wxt prepare",
    "test:e2e": "node scripts/e2e.mjs",
    "typecheck": "tsc --noEmit",
    "zip": "wxt zip"
  },
  "dependencies": {
    "openai": "7.27.0",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@tsconfig/strictest": "2.0.8",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "playwright-core": "1.63.0",
    "typescript": "6.0.3",
    "wxt": "0.21.4"
  },
  "packageManager": "pnpm@12.9.1"
}
