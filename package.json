{
  "name": "yomi",
  "version": "0.1.0",
  "private": true,
  "description": "ChatGPT プランで Web ページ全体や選択テキストを翻訳する Chrome 拡張",
  "type": "module",
  "scripts": {
    "build": "wxt build",
    "dev": "wxt",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "postinstall": "wxt prepare",
    "test": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "typecheck": "tsc --noEmit",
    "zip": "wxt zip"
  },
  "dependencies": {
    "openai": "7.27.0",
    "solid-js": "1.9.15"
  },
  "devDependencies": {
    "@tsconfig/strictest": "2.0.8",
    "happy-dom": "20.14.5",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "playwright-core": "1.63.0",
    "typescript": "6.0.3",
    "vite-plugin-solid": "2.11.14",
    "vitest": "5.0.3",
    "wxt": "0.21.4"
  },
  "packageManager": "pnpm@12.9.1"
}
